diff --git a/launcher/build-and-install.ps1 b/launcher/build-and-install.ps1
index eaab3dc..8a0e9cb 100644
--- a/launcher/build-and-install.ps1
+++ b/launcher/build-and-install.ps1
@@ -1,46 +1,3 @@
-# Windows version of build-and-install.sh: build the launcher APK and install it on the TV as the
-# default home screen. Uses Android Studio's bundled JDK and the default SDK location unless
-# JAVA_HOME / ANDROID_HOME are set.
-#
-# Usage: launcher\build-and-install.ps1 -TvHost 192.168.1.50 [-StockLauncher com.google.android.tvlauncher]
-param(
-    [string]$TvHost = $env:TV_HOST,
-    [string]$StockLauncher = 'com.google.android.tvlauncher'
-)
-$ErrorActionPreference = 'Stop'
-# Pipe plain UTF-8 to native commands; the default here prepends a BOM that corrupts the first command.
-$OutputEncoding = New-Object System.Text.UTF8Encoding $false
-if (-not $TvHost) { throw 'pass -TvHost <tv ip> or set $env:TV_HOST' }
-$env:TV_HOST = $TvHost
-Set-Location $PSScriptRoot
-
-if (-not $env:JAVA_HOME -or -not (Test-Path "$env:JAVA_HOME\bin\java.exe")) {
-    $jbr = Get-ChildItem 'C:\Program Files\Android' -Directory -ErrorAction SilentlyContinue |
-        ForEach-Object { Join-Path $_.FullName 'jbr' } | Where-Object { Test-Path "$_\bin\java.exe" } | Select-Object -First 1
-    if (-not $jbr) { throw 'Set JAVA_HOME to a JDK 17+ (Android Studio ships one in its jbr folder)' }
-    $env:JAVA_HOME = $jbr
-}
-$sdk = if ($env:ANDROID_HOME) { $env:ANDROID_HOME } else { "$env:LOCALAPPDATA\Android\Sdk" }
-if (-not (Test-Path local.properties)) {
-    "sdk.dir=$($sdk -replace '\\', '\\')" | Out-File -Encoding ascii local.properties
-}
-
-.\gradlew.bat assembleDebug -q --console=plain
-if ($LASTEXITCODE -ne 0) { throw 'Gradle build failed' }
-
-$py = '..\tools\venv\Scripts\python.exe'
-$apk = 'app\build\outputs\apk\debug\app-debug.apk'
-& $py -I ..\tools\b64push.py $apk /data/local/tmp/tvhome.apk
-if ($LASTEXITCODE -ne 0) { throw 'APK upload failed' }
-$out = & $py -I ..\tools\tv.py 'pm install -r /data/local/tmp/tvhome.apk; rm -f /data/local/tmp/tvhome.apk'
-Write-Host $out
-if ("$out" -notmatch 'Success') { throw 'pm install failed; the stock launcher was left untouched' }
-$out = & $py -I ..\tools\tv.py 'cmd package set-home-activity --user 0 com.gathin.tvhome'
-Write-Host $out
-if ("$out" -match 'Error') { throw 'could not set the new launcher as home; the stock launcher was left untouched' }
-@(
-    'pm grant com.gathin.tvhome android.permission.ACCESS_FINE_LOCATION 2>/dev/null; echo location-granted',
-    'cmd package set-home-activity --user 0 com.gathin.tvhome',
-    "pm disable-user --user 0 $StockLauncher"
-) | & $py -I ..\tools\tv.py --batch
-Write-Host 'Installed. Press Home on the remote to see it.'
+# Legacy entry point intentionally blocked in this local investigation branch.
+# Build/install/default switching/recovery are separate reviewed operations.
+throw 'Legacy combined installer is blocked. Use the enclosing project scripts/Build-Vibehack.ps1 and then scripts/Install-Apk.ps1 after reviewing the firmware record. Nothing was installed or changed.'
diff --git a/launcher/build-and-install.sh b/launcher/build-and-install.sh
index 9c9d2ed..100abb5 100755
--- a/launcher/build-and-install.sh
+++ b/launcher/build-and-install.sh
@@ -1,24 +1,4 @@
 #!/usr/bin/env bash
-# Build the launcher APK and install it on the TV as the default home screen.
 set -euo pipefail
-cd "$(dirname "$0")"
-: "${TV_HOST:?set TV_HOST to the TV IP address, e.g. TV_HOST=192.168.1.50 $0}"
-STOCK_LAUNCHER="${STOCK_LAUNCHER:-com.google.android.tvlauncher}"
-export JAVA_HOME="${JAVA_HOME:-$(/usr/libexec/java_home -v 17 2>/dev/null || echo /opt/homebrew/opt/openjdk@17)}"
-export ANDROID_HOME="${ANDROID_HOME:-$([ -d ~/Library/Android/sdk ] && echo ~/Library/Android/sdk || echo /opt/homebrew/share/android-commandlinetools)}"
-export PATH="$JAVA_HOME/bin:$PATH"
-[ -f local.properties ] || echo "sdk.dir=$ANDROID_HOME" > local.properties
-./gradlew assembleDebug -q --console=plain
-PY=../tools/venv/bin/python
-[ -x "$PY" ] || PY=../tools/venv/Scripts/python.exe
-export MSYS_NO_PATHCONV=1
-APK=app/build/outputs/apk/debug/app-debug.apk
-"$PY" -I ../tools/b64push.py "$APK" /data/local/tmp/tvhome.apk
-printf '%s\n' \
-  "pm install -r /data/local/tmp/tvhome.apk" \
-  "rm -f /data/local/tmp/tvhome.apk" \
-  "pm grant com.gathin.tvhome android.permission.ACCESS_FINE_LOCATION 2>/dev/null; echo location-granted" \
-  "cmd package set-home-activity --user 0 com.gathin.tvhome/.MainActivity" \
-  "pm disable-user --user 0 $STOCK_LAUNCHER" \
-  | "$PY" -I ../tools/tv.py --batch
-echo "Installed. Press Home on the remote to see it."
+printf '%s\n' 'Legacy combined installer is blocked in this branch. Use the enclosing reviewed PowerShell build and install-only scripts. Nothing was changed.' >&2
+exit 1
